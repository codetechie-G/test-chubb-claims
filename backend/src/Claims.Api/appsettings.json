{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Claims": "Data Source=claims.db"
  },
  "Messaging": {
    "Transport": "InMemory",
    "Topic": "claims.claim-events",
    "BootstrapServers": "localhost:9092"
  },
  "Jwt": {
    "Issuer": "chubb-claims-demo",
    "Audience": "chubb-claims-ui",
    "SigningKey": "local-dev-only-signing-key-change-me-0123456789abcdef",
    "LifetimeMinutes": 480
  },
  "Reporting": {
    "Currency": "USD",
    "FxRates": {
      "AUD": 0.66,
      "NZD": 0.60,
      "SGD": 0.77,
      "HKD": 0.128,
      "MYR": 0.23,
      "THB": 0.029
    }
  },
  "SeedDemoData": true
}
